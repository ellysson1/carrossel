# ── Provedor de imagem ────────────────────────────────────────────────────────
# kie | gemini | none
IMAGE_PROVIDER=kie

# Kie.ai — https://kie.ai  (Perfil → API Key)
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai/api/v1
# Confira o identificador exato do modelo em docs.kie.ai (aba do modelo que você usa).
KIE_MODEL=google/nano-banana
# Campo de proporção aceito pelo modelo: aspect_ratio | image_size
KIE_ASPECT_FIELD=aspect_ratio

# Google Gemini (AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image

# ── Geração de texto ──────────────────────────────────────────────────────────
# claude-cli (usa o login do Claude Code, sem chave) | anthropic (usa a chave abaixo)
COPY_PROVIDER=claude-cli
ANTHROPIC_API_KEY=
